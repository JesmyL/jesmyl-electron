{
  "name": "jesmyl-electron",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "keywords": [],
  "author": "gfirf",
  "email": "gfirf@gfirf.ru",
  "license": "ISC",
  "description": "",
  "scripts": {
    "start": "electron .",
    "build": "docker run --rm -it -v ${PWD}:/project -w /project -e ELECTRON_CACHE=\"/root/.cache/electron\" electronuserland/builder:wine-mono sh -c \"npm ci --legacy-peer-deps && npx electron-builder --win --linux\"",
    "release": "npm --no-git-tag-version version patch && npm run build && node ./release.mjs"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0"
  },
  "main": "electron.driver.mjs",
  "build": {
    "appId": "com.example.presentation",
    "productName": "JESMYL_PRO",
    "files": [
      "**/*",
      "assets/**/*",
      "!node_modules/*/{test,__tests__,*.md}"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://jesmyl.ru/down"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/img/ico-512x512.png",
      "artifactName": "JESMYL_PRO.${ext}"
    },
    "linux": {
      "publish": [
        {
          "provider": "generic",
          "url": "https://jesmyl.ru/down"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "asarUnpack": [
        "**/chrome-sandbox**"
      ],
      "icon": "assets/img/ico-512x512.png",
      "artifactName": "JESMYL_PRO.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
