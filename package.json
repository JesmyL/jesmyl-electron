{
  "name": "jesmyl-electron",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "keywords": [],
  "author": "gfirf",
  "email": "gfirf@gfirf.ru",
  "license": "ISC",
  "description": "",
  "scripts": {
    "start": "electron .",
    "build": "docker run --rm -it -v ${PWD}:/project -w /project -e ELECTRON_CACHE=\"/root/.cache/electron\" electronuserland/builder:wine-mono sh -c \"npm ci --legacy-peer-deps && npx electron-builder --win --linux\""
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0"
  },
  "main": "electron.driver.mjs",
  "build": {
    "appId": "com.example.presentation",
    "productName": "JESMYL_PRO",
    "files": [
      "**/*",
      "!node_modules/*/{test,__tests__,*.md}"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "asarUnpack": [
        "**/chrome-sandbox**"
      ]
    }
  }
}
